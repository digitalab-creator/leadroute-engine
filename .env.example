# LeadRoute — copy to .env and fill in. The app runs with GEMINI_API_KEY empty.
# Seed messages use reviewed fixtures. An unknown paste uses the rules fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional paths (defaults: var/revops.sqlite, data/, logs/)
# LEADROUTE_DB_PATH=
# LEADROUTE_DATA_DIR=
# LEADROUTE_LOG_DIR=
